<Window x:Class="SensorAnalysis.Sphere.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SensorAnalysis — Spherical Platform"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New World" Click="NewWorld_Click"/>
        <MenuItem Header="New World (_options)…" Click="NewWorldOptions_Click"/>
        <Separator/>
        <MenuItem Header="_Open Scenario…" Click="OpenScenario_Click"/>
        <MenuItem Header="_Save Scenario…" Click="SaveScenario_Click"/>
        <MenuItem Header="_Export Metrics…" Click="ExportMetrics_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Simulation">
        <MenuItem Header="_Step" Click="Step_Click" InputGestureText="F10"/>
        <MenuItem Header="_Run" Click="Run_Click" InputGestureText="F5"/>
        <MenuItem Header="S_top" Click="Stop_Click" InputGestureText="Shift+F5"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ViewCenteredMenuItem" Header="_Centered"
                  IsCheckable="True" IsChecked="True" Click="ViewCentered_Changed"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _updates…" Click="CheckForUpdates_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="TickText" Text="tick 0"/>
      </StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Width="50" Click="NewWorld_Click" ToolTip="New world with last options and default tick-0 directives"/>
        <Button Content="New…" Width="50" Click="NewWorldOptions_Click" ToolTip="New world options"/>
        <Separator/>
        <Button Content="Step" Width="50" Click="Step_Click"/>
        <Button x:Name="RunButton" Content="Run" Width="50" Click="Run_Click"/>
        <Button Content="Stop" Width="50" Click="Stop_Click"/>
        <Separator/>
        <CheckBox x:Name="ViewCenteredCheckBox" Content="Centered" IsChecked="True"
                  VerticalAlignment="Center" Margin="4,0"
                  ToolTip="When on, keep the sphere centered; when off, drag to orbit and follow selection"
                  Checked="ViewCentered_Changed" Unchecked="ViewCentered_Changed"/>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="360" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#1E1E1E" ClipToBounds="True">
        <Viewport3D x:Name="WorldViewport"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#555" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
          <StackPanel>
            <Expander Header="Selection" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Foreground="#DDD" Margin="0,6,0,0"
                         Text="Click an agent or incident marker to inspect it."/>
            </Expander>

            <Expander Header="Messages" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <DockPanel Margin="0,6,0,0" LastChildFill="True" MinHeight="160">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock Text="Filter" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="MessageFilterBox" Height="22" VerticalContentAlignment="Center"
                           ToolTip="Match tick, agent id, incident id, or any message text"
                           TextChanged="MessageFilterBox_TextChanged"/>
                </DockPanel>
                <TextBlock x:Name="MessageSummary" DockPanel.Dock="Bottom" Foreground="#AAA"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ListBox x:Name="MessageLog" FontFamily="Consolas" FontSize="11"
                         Background="#1B1B1B" Foreground="#E8E8E8" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MinHeight="120" MaxHeight="220"/>
              </DockPanel>
            </Expander>

            <Expander Header="Deployment" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <StackPanel Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#AAA" FontSize="11" Margin="0,0,0,8"
                           Text="Worlds start empty. Schedule directives (including tick 0) to populate agents, incidents, and watchers."/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="At tick" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="DirectiveTickBox" Text="0" Margin="0,2" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="1" Text="Action" Foreground="#CCC" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DirectiveKindBox" SelectedIndex="0" Margin="0,2">
                    <ComboBoxItem Content="DeployUniformAgents"/>
                    <ComboBoxItem Content="DeployNearHost"/>
                    <ComboBoxItem Content="DeployPeriodicIncidents"/>
                    <ComboBoxItem Content="EnableCoverageWatcher"/>
                  </ComboBox>
                  <TextBlock Grid.Row="2" Text="Agent kind" Foreground="#CCC" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AgentKindBox" SelectedIndex="2" Margin="0,2">
                    <ComboBoxItem Content="RandomWalk"/>
                    <ComboBoxItem Content="Stationary"/>
                    <ComboBoxItem Content="CooperativeSearch"/>
                  </ComboBox>
                  <TextBlock Grid.Row="3" Text="Count" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="3" Grid.Column="1" x:Name="AgentCountBox" Text="5" Margin="0,2" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="4" Text="r / c" Foreground="#CCC" VerticalAlignment="Center"/>
                  <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,2">
                    <TextBox x:Name="DirectiveSensorBox" Text="100" Width="70" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="DirectiveCommBox" Text="200" Width="70" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Grid.Row="5" Text="Period" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="5" Grid.Column="1" x:Name="DirectivePeriodBox" Text="20" Margin="0,2" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="6" Text="Incident" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="6" Grid.Column="1" x:Name="DirectiveIncidentTypeBox" Text="StationaryIncident" Margin="0,2" VerticalContentAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                  <Button Content="Schedule" Padding="8,3" Click="ScheduleDirective_Click"/>
                  <Button Content="Apply now" Padding="8,3" Margin="6,0,0,0" Click="ApplyDirectiveNow_Click"/>
                  <Button Content="Remove selected" Padding="8,3" Margin="6,0,0,0" Click="RemoveDirective_Click"/>
                </StackPanel>
                <ListBox x:Name="DirectiveList" MinHeight="80" MaxHeight="140"
                         Background="#1B1B1B" Foreground="#DDD" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
            </Expander>

            <Expander Header="Live metrics" IsExpanded="True" Foreground="#EEE">
              <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="MetricsSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#DDD"
                           FontFamily="Consolas" FontSize="12"/>
                <ListBox x:Name="MetricHistoryLog" Margin="0,8,0,0" MaxHeight="180"
                         Background="#1B1B1B" Foreground="#DDD" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
