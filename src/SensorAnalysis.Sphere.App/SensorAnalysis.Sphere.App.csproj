<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SensorAnalysis.Sphere.App</AssemblyName>
    <RootNamespace>SensorAnalysis.Sphere.App</RootNamespace>
    <!-- Keep equal to distribution/products.json. A version increase on the default branch publishes this product. -->
    <Version>0.2.0</Version>
    <StartupObject>SensorAnalysis.Sphere.App.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SensorAnalysis.Sphere.Core\SensorAnalysis.Sphere.Core.csproj" />
    <ProjectReference Include="..\SensorAnalysis.Distribution\SensorAnalysis.Distribution.csproj" />
    <ProjectReference Include="..\SensorAnalysis.Updates\SensorAnalysis.Updates.csproj" />
  </ItemGroup>
</Project>
