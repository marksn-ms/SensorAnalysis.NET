<Window x:Class="SensorAnalysis.Space.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SensorAnalysis — Space"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New World" Click="NewWorld_Click"/>
        <MenuItem Header="New World (_options)…" Click="NewWorldOptions_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Simulation">
        <MenuItem Header="_Step" Click="Step_Click" InputGestureText="F10"/>
        <MenuItem Header="_Run" Click="Run_Click" InputGestureText="F5"/>
        <MenuItem Header="S_top" Click="Stop_Click" InputGestureText="Shift+F5"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ViewCenteredMenuItem" Header="_Follow selection"
                  IsCheckable="True" IsChecked="True" Click="ViewCentered_Changed"/>
        <MenuItem x:Name="FlyMenuItem" Header="F_ly (god mode)"
                  IsCheckable="True" Click="Fly_Changed"/>
        <MenuItem Header="_Reset camera" Click="ResetCamera_Click" InputGestureText="Home"/>
        <MenuItem Header="_Frame selection" Click="FrameSelection_Click" InputGestureText="F"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _updates…" Click="CheckForUpdates_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="TickText" Text="tick 0"/>
      </StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Width="50" Click="NewWorld_Click" ToolTip="New world with last options"/>
        <Button Content="New…" Width="50" Click="NewWorldOptions_Click"/>
        <Separator/>
        <Button Content="Step" Width="50" Click="Step_Click"/>
        <Button x:Name="RunButton" Content="Run" Width="50" Click="Run_Click"/>
        <Button Content="Stop" Width="50" Click="Stop_Click"/>
        <Separator/>
        <TextBlock Text="Delay ms" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <TextBox x:Name="DelayBox" Width="48" Text="45" VerticalContentAlignment="Center"
                 LostFocus="DelayBox_LostFocus"/>
        <Separator/>
        <CheckBox x:Name="ViewCenteredCheckBox" Content="Follow" IsChecked="True"
                  VerticalAlignment="Center" Margin="4,0"
                  ToolTip="Keep the camera looking at the origin or the current selection"
                  Checked="ViewCentered_Changed" Unchecked="ViewCentered_Changed"/>
        <CheckBox x:Name="FlyCheckBox" Content="Fly"
                  VerticalAlignment="Center" Margin="8,0"
                  ToolTip="God-mode fly: WASD move, Q/E up/down, left-drag look. Disables follow."
                  Checked="Fly_Changed" Unchecked="Fly_Changed"/>
        <Separator/>
        <TextBlock Text="FOV" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <TextBox x:Name="FovBox" Width="40" Text="48" VerticalContentAlignment="Center"
                 LostFocus="FovBox_LostFocus" ToolTip="Horizontal field of view (35–75°)"/>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="340" MinWidth="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#07090E" ClipToBounds="True">
        <Viewport3D x:Name="WorldViewport" Focusable="True"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel"
                    MouseDown="Viewport_MouseDown"
                    MouseUp="Viewport_MouseUp"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#555" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
          <StackPanel>
            <Expander Header="Selection" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" Foreground="#DDD" Margin="0,6,0,0"
                         FontFamily="Consolas" FontSize="12"
                         Text="Click an inhabitant to inspect it."/>
            </Expander>

            <Expander Header="World" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <TextBlock x:Name="WorldSummary" TextWrapping="Wrap" Foreground="#DDD" Margin="0,6,0,0"
                         FontFamily="Consolas" FontSize="12"/>
            </Expander>

            <Expander Header="Messages" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <DockPanel Margin="0,6,0,0" LastChildFill="True" MinHeight="140">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock Text="Filter" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBox x:Name="MessageFilterBox" Height="22" VerticalContentAlignment="Center"
                           ToolTip="Match tick or any message text"
                           TextChanged="MessageFilterBox_TextChanged"/>
                </DockPanel>
                <TextBlock x:Name="MessageSummary" DockPanel.Dock="Bottom" Foreground="#AAA"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ListBox x:Name="MessageLog" FontFamily="Consolas" FontSize="11"
                         Background="#1B1B1B" Foreground="#E8E8E8" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MinHeight="100" MaxHeight="180"/>
              </DockPanel>
            </Expander>

            <Expander Header="Deployment" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <StackPanel Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#AAA" FontSize="11" Margin="0,0,0,8"
                           Text="Schedule directives (including tick 0) to add weavers, asteroids, or a coverage watcher."/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="At tick" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="DirectiveTickBox" Text="0" Margin="0,2" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="1" Text="Action" Foreground="#CCC" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DirectiveKindBox" SelectedIndex="0" Margin="0,2">
                    <ComboBoxItem Content="DeployUniformAgents"/>
                    <ComboBoxItem Content="DeployAsteroids"/>
                    <ComboBoxItem Content="EnableCoverageWatcher"/>
                  </ComboBox>
                  <TextBlock Grid.Row="2" Text="Count" Foreground="#CCC" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="2" Grid.Column="1" x:Name="DirectiveCountBox" Text="4" Margin="0,2" VerticalContentAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                  <Button Content="Schedule" Padding="8,3" Click="ScheduleDirective_Click"/>
                  <Button Content="Apply now" Padding="8,3" Margin="6,0,0,0" Click="ApplyDirectiveNow_Click"/>
                  <Button Content="Remove selected" Padding="8,3" Margin="6,0,0,0" Click="RemoveDirective_Click"/>
                </StackPanel>
                <ListBox x:Name="DirectiveList" MinHeight="72" MaxHeight="120"
                         Background="#1B1B1B" Foreground="#DDD" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"/>
              </StackPanel>
            </Expander>

            <Expander Header="Live metrics" IsExpanded="True" Foreground="#EEE" Margin="0,0,0,8">
              <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="MetricsSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#DDD"
                           FontFamily="Consolas" FontSize="12"/>
                <ListBox x:Name="MetricHistoryLog" Margin="0,8,0,0" MaxHeight="160"
                         Background="#1B1B1B" Foreground="#DDD" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </Expander>

            <Expander Header="Camera" IsExpanded="False" Foreground="#EEE">
              <TextBlock x:Name="CameraHelp" TextWrapping="Wrap" Foreground="#BBB" Margin="0,6,0,0" FontSize="11"
                         Text="LMB drag: orbit · click: select inhabitant · MMB / Shift+LMB: pan · wheel: zoom · arrows: orbit · Home: reset isometric · F: frame selection · Fly: WASD + QE."/>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
