<Window x:Class="SensorAnalysis.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SensorAnalysis.App.Controls"
        Title="SensorAnalysis" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New World" Command="{Binding NewWorldCommand}"/>
        <MenuItem Header="_Open Scenario…" Command="{Binding LoadScenarioCommand}"/>
        <MenuItem Header="_Save Scenario…" Command="{Binding SaveScenarioCommand}"/>
        <Separator/>
        <MenuItem Header="_Export Metrics…" Command="{Binding ExportCommand}"/>
        <MenuItem Header="Capture _Frame" Command="{Binding CaptureFrameCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Simulation">
        <MenuItem Header="_Step" Command="{Binding StepCommand}" InputGestureText="F10"/>
        <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F5"/>
        <MenuItem Header="S_top" Command="{Binding StopCommand}" InputGestureText="Shift+F5"/>
        <Separator/>
        <MenuItem Header="Apply _due directives" Command="{Binding ApplyDueDirectivesCommand}"/>
        <MenuItem Header="Apply directive _now" Command="{Binding ApplyDirectiveNowCommand}"/>
        <Separator/>
        <MenuItem Header="Run _Experiment…" Command="{Binding RunExperimentCommand}"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding TickText}"/>
      </StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Command="{Binding NewWorldCommand}" Width="50"/>
        <Separator/>
        <Button Content="Step" Command="{Binding StepCommand}" Width="50"/>
        <Button Content="Run" Command="{Binding RunCommand}" Width="50"/>
        <Button Content="Stop" Command="{Binding StopCommand}" Width="50"/>
        <Separator/>
        <CheckBox Content="Record frames" IsChecked="{Binding RecordFrames}"
                  VerticalAlignment="Center" Margin="4,0"/>
        <TextBlock Text="every" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Text="{Binding FrameEveryNTicks, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
        <TextBlock Text="ticks" VerticalAlignment="Center" Margin="4,0"/>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="360" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#1e1e1e" ClipToBounds="True">
        <controls:WorldCanvas x:Name="WorldView"
                              World="{Binding World}"
                              Zoom="{Binding Zoom, Mode=TwoWay}"
                              SelectedObject="{Binding SelectedObject, Mode=TwoWay}"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Selection" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <TextBlock FontWeight="SemiBold" Text="Legend" Margin="0,0,0,4"/>
          <ItemsControl ItemsSource="{Binding LegendEntries}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Border DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0"
                          Background="{Binding SwatchBrush}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Caption}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="10"
                             Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock FontWeight="SemiBold" Text="Environment directives" Margin="0,0,0,4"/>
          <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,0,0,6"
                     Text="Schedule deployments by tick. Tick 0 runs before the first Step/Run. Pause to inject mid-run."/>

          <Border BorderBrush="#CCC" BorderThickness="1" Padding="6" Margin="0,0,0,8" Background="#F7F7F7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="At tick" VerticalAlignment="Center" Margin="0,2,6,2"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftAtTick, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Deployer" VerticalAlignment="Center" Margin="8,2,6,2"/>
              <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding DeployerNames}"
                        SelectedItem="{Binding DraftDeployerName}" Margin="0,2"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Agents" VerticalAlignment="Center" Margin="0,2,6,2"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftAgentCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Type" VerticalAlignment="Center" Margin="8,2,6,2"/>
              <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding AgentTypeNames}"
                        SelectedItem="{Binding DraftAgentTypeName}" Margin="0,2"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Adversaries" VerticalAlignment="Center" Margin="0,2,6,2"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftAdversaryCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Adv type" VerticalAlignment="Center" Margin="8,2,6,2"/>
              <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding AgentTypeNames}"
                        SelectedItem="{Binding DraftAdversaryTypeName}" Margin="0,2"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Incidents" VerticalAlignment="Center" Margin="0,2,6,2"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DraftIncidentCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>

              <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add to log" Command="{Binding AddDirectiveCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Apply now" Command="{Binding ApplyDirectiveNowCommand}" Padding="8,2" Margin="0,0,6,0"/>
                <Button Content="Apply due" Command="{Binding ApplyDueDirectivesCommand}" Padding="8,2"/>
              </StackPanel>
            </Grid>
          </Border>

          <ListBox ItemsSource="{Binding Directives}"
                   SelectedItem="{Binding SelectedDirective}"
                   MinHeight="80" MaxHeight="160"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                             Text="{Binding Status}"/>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Remove selected" Command="{Binding RemoveDirectiveCommand}"
                  HorizontalAlignment="Left" Margin="0,4,0,12" Padding="8,2"/>

          <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Live metrics"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="+" Width="28"
                    Command="{Binding AddMetricSeriesCommand}" ToolTip="Add metric series"/>
            <ComboBox Margin="8,0" ItemsSource="{Binding MetricCatalog}"
                      SelectedItem="{Binding SelectedCatalogEntry}"
                      DisplayMemberPath="DisplayName"/>
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,0,0,6"
                     Text="X-axis is always ticks. Choose inherent world stats or columns published by registered watchers."/>

          <ItemsControl ItemsSource="{Binding MetricSeries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22"
                            Command="{Binding DataContext.RemoveMetricSeriesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Remove series" VerticalAlignment="Top"/>
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentText}"
                                   FontFamily="Consolas" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                      </DockPanel>
                      <controls:SparklineControl Samples="{Binding Samples}"
                                                 Height="36" Margin="0,4,0,0"
                                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
