<Window x:Class="SensorAnalysis.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SensorAnalysis.App.Controls"
        Title="SensorAnalysis" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New World" Command="{Binding NewWorldCommand}"/>
        <MenuItem Header="New World (_options)…" Command="{Binding NewWorldWithOptionsCommand}"/>
        <MenuItem Header="_Open Scenario…" Command="{Binding LoadScenarioCommand}"/>
        <MenuItem Header="_Save Scenario…" Command="{Binding SaveScenarioCommand}"/>
        <MenuItem Header="Open _Recipe…" Command="{Binding LoadRecipeCommand}"/>
        <MenuItem Header="Save R_ecipe…" Command="{Binding SaveRecipeCommand}"/>
        <Separator/>
        <MenuItem Header="_Export Metrics…" Command="{Binding ExportCommand}"/>
        <MenuItem Header="Capture _Frame" Command="{Binding CaptureFrameCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Simulation">
        <MenuItem Header="_Step" Command="{Binding StepCommand}" InputGestureText="F10"/>
        <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F5"/>
        <MenuItem Header="S_top" Command="{Binding StopCommand}" InputGestureText="Shift+F5"/>
        <Separator/>
        <MenuItem Header="Apply _due directives" Command="{Binding ApplyDueDirectivesCommand}"/>
        <MenuItem Header="Apply directive _now" Command="{Binding ApplyDirectiveNowCommand}"/>
        <Separator/>
        <MenuItem Header="Run _Experiment…" Command="{Binding RunExperimentCommand}"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Centered" IsCheckable="True" IsChecked="{Binding ViewCentered}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Check for _updates…" Click="CheckForUpdates_Click"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding TickText}"/>
      </StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Command="{Binding NewWorldCommand}" Width="50"/>
        <Button Content="New…" Command="{Binding NewWorldWithOptionsCommand}" Width="50"
                ToolTip="New world with options"/>
        <Separator/>
        <Button Content="Step" Command="{Binding StepCommand}" Width="50"/>
        <Button Content="Run" Command="{Binding RunCommand}" Width="50"/>
        <Button Content="Stop" Command="{Binding StopCommand}" Width="50"/>
        <Separator/>
        <CheckBox Content="Centered" IsChecked="{Binding ViewCentered}"
                  VerticalAlignment="Center" Margin="4,0"
                  ToolTip="When on, keep the world centered; when off, drag to pan and follow selection"/>
        <Separator/>
        <TextBlock Text="Delay ms:" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Text="{Binding TickDelayMs, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
        <Separator/>
        <CheckBox Content="Record frames" IsChecked="{Binding RecordFrames}"
                  VerticalAlignment="Center" Margin="4,0"/>
        <CheckBox Content="Record video" IsChecked="{Binding RecordVideo}"
                  VerticalAlignment="Center" Margin="8,0,4,0"
                  ToolTip="Capture MJPEG AVI on Stop (same every-N-ticks cadence)"/>
        <TextBlock Text="every" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Text="{Binding FrameEveryNTicks, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
        <TextBlock Text="ticks" VerticalAlignment="Center" Margin="4,0"/>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="360" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="180" MinHeight="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1e1e1e" ClipToBounds="True">
          <controls:WorldCanvas x:Name="WorldView"
                                World="{Binding World}"
                                Zoom="{Binding Zoom, Mode=TwoWay}"
                                ViewCentered="{Binding ViewCentered, Mode=TwoWay}"
                                SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                                SelectedTile="{Binding SelectedTile, Mode=TwoWay}"/>
        </Border>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeDirection="Rows"/>

        <DockPanel Grid.Row="2" Background="#161616" LastChildFill="True">
          <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <TextBlock DockPanel.Dock="Left" Text="Radio traffic" FontWeight="SemiBold"
                       Foreground="#DDD" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Clear" Padding="8,1"
                    Command="{Binding ClearRadioLogCommand}"
                    ToolTip="Clear narrated radio log"/>
            <TextBlock Margin="12,0,0,0" Opacity="0.55" FontSize="11" Foreground="#AAA"
                       VerticalAlignment="Center"
                       Text="Color = sender type · contact / orbit / break / status"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding RadioLog}"
                   Background="#111" BorderThickness="0" Margin="4,0,4,4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2,2">
                  <Border DockPanel.Dock="Left" Width="4" Margin="0,0,8,0"
                          Background="{Binding TypeBrush}" CornerRadius="1"/>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Prefix}"
                             FontFamily="Consolas" FontSize="11" Foreground="#888"
                             Margin="0,0,8,0" VerticalAlignment="Top"/>
                  <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap"
                             FontSize="12" Foreground="{Binding TypeBrush}"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Selection" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <TextBlock FontWeight="SemiBold" Text="Legend" Margin="0,0,0,4"/>
          <ItemsControl ItemsSource="{Binding LegendEntries}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Border DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0"
                          Background="{Binding SwatchBrush}" CornerRadius="2" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Caption}" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="10"
                             Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock FontWeight="SemiBold" Text="Environment directives" Margin="0,0,0,4"/>
          <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,0,0,6"
                     Text="At a tick, add a deployer with its own parameters. Multiple rows may share the same tick. Due directives apply automatically on Step/Run."/>

          <Border BorderBrush="#CCC" BorderThickness="1" Padding="6" Margin="0,0,0,8" Background="#F7F7F7">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="At tick" VerticalAlignment="Center" Margin="0,2,6,2"/>
                <TextBox Grid.Column="1" Text="{Binding DraftAtTick, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Column="2" Text="Deployer" VerticalAlignment="Center" Margin="8,2,6,2"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding DeployerNames}"
                          SelectedItem="{Binding DraftDeployerName}" Margin="0,2"/>
              </Grid>

              <ItemsControl ItemsSource="{Binding DraftFields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                 ToolTip="{Binding Description}" Margin="0,0,6,0"/>
                      <CheckBox Grid.Column="1" Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"
                                IsChecked="{Binding BoolValue}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" Visibility="{Binding IsChoiceCombo, Converter={StaticResource BoolToVis}}"
                                ItemsSource="{Binding ChoiceValues}"
                                SelectedItem="{Binding ChoiceValue}"
                                IsEditable="True"/>
                      <TextBox Grid.Column="1" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                               Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding DraftValidationMessage}" Foreground="#A33" FontSize="11"
                         TextWrapping="Wrap" Margin="0,4,0,0"/>
              <Button Content="Add" Command="{Binding AddDirectiveCommand}"
                      HorizontalAlignment="Left" Padding="12,2" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <ListBox ItemsSource="{Binding Directives}"
                   SelectedItem="{Binding SelectedDirective}"
                   MinHeight="80" MaxHeight="160"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <TextBlock DockPanel.Dock="Right" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                             Text="{Binding Status}"/>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="Remove selected" Command="{Binding RemoveDirectiveCommand}"
                  HorizontalAlignment="Left" Margin="0,4,0,12" Padding="8,2"/>

          <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="Live metrics"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="+" Width="28"
                    Command="{Binding AddMetricSeriesCommand}" ToolTip="Add metric series"/>
            <ComboBox Margin="8,0" ItemsSource="{Binding MetricCatalog}"
                      SelectedItem="{Binding SelectedCatalogEntry}"
                      DisplayMemberPath="DisplayName"/>
          </DockPanel>
          <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11" Margin="0,0,0,6"
                     Text="X-axis is always ticks. Choose inherent world stats or columns published by registered watchers."/>

          <ItemsControl ItemsSource="{Binding MetricSeries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22"
                            Command="{Binding DataContext.RemoveMetricSeriesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="Remove series" VerticalAlignment="Top"/>
                    <StackPanel>
                      <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentText}"
                                   FontFamily="Consolas" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                      </DockPanel>
                      <controls:SparklineControl Samples="{Binding Samples}"
                                                 Height="36" Margin="0,4,0,0"
                                                 HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
