<Window x:Class="SensorAnalysis.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SensorAnalysis.App.Controls"
        Title="SensorAnalysis" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New World" Command="{Binding NewWorldCommand}"/>
        <MenuItem Header="_Open Scenario…" Command="{Binding LoadScenarioCommand}"/>
        <MenuItem Header="_Save Scenario…" Command="{Binding SaveScenarioCommand}"/>
        <Separator/>
        <MenuItem Header="_Export Metrics…" Command="{Binding ExportCommand}"/>
        <MenuItem Header="Capture _Frame" Command="{Binding CaptureFrameCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Simulation">
        <MenuItem Header="_Step" Command="{Binding StepCommand}" InputGestureText="F10"/>
        <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F5"/>
        <MenuItem Header="S_top" Command="{Binding StopCommand}" InputGestureText="Shift+F5"/>
        <Separator/>
        <MenuItem Header="Run _Experiment…" Command="{Binding RunExperimentCommand}"/>
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding TickText}"/>
      </StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="New" Command="{Binding NewWorldCommand}" Width="50"/>
        <Separator/>
        <Button Content="Step" Command="{Binding StepCommand}" Width="50"/>
        <Button Content="Run" Command="{Binding RunCommand}" Width="50"/>
        <Button Content="Stop" Command="{Binding StopCommand}" Width="50"/>
        <Separator/>
        <TextBlock Text="Agents:" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Text="{Binding AgentCount, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
        <TextBlock Text="Incidents:" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <TextBox Text="{Binding IncidentCount, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
        <TextBlock Text="Type:" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <ComboBox ItemsSource="{Binding AgentTypeNames}"
                  SelectedItem="{Binding SelectedAgentType}" Width="120"/>
        <Button Content="Deploy" Command="{Binding DeployCommand}" Width="60" Margin="8,0,0,0"/>
        <Separator/>
        <CheckBox Content="Record frames" IsChecked="{Binding RecordFrames}"
                  VerticalAlignment="Center" Margin="4,0"/>
        <TextBlock Text="every" VerticalAlignment="Center" Margin="4,0"/>
        <TextBox Text="{Binding FrameEveryNTicks, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
        <TextBlock Text="ticks" VerticalAlignment="Center" Margin="4,0"/>
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#1e1e1e" ClipToBounds="True">
        <controls:WorldCanvas x:Name="WorldView"
                              World="{Binding World}"
                              Zoom="{Binding Zoom, Mode=TwoWay}"
                              SelectedObject="{Binding SelectedObject, Mode=TwoWay}"/>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <DockPanel Grid.Column="2" Margin="8">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="Selection"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap"/>
            <Separator Margin="0,12"/>
            <TextBlock FontWeight="SemiBold" Text="Live metrics" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding LiveMetricsText}" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
